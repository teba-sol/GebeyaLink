# =============================================================================
# GebeyaLink — environment template (placeholders only, no secrets)
# Copy relevant values into the app-level env file:
#   apps/web/.env          (Next.js + drizzle-kit — real values go here, never committed)
# =============================================================================

# --- Database (PostgreSQL on Supabase) ---------------------------------------
# Use the Session pooler URI from:
# Supabase Dashboard -> Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# --- Authentication (Better Auth) --------------------------------------------
# Generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=replace-with-generated-secret
BETTER_AUTH_URL=http://localhost:3000

# --- App URLs ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Base URL the Expo app uses to reach the API (your machine's LAN IP for devices)
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- Redis (cache) — local Redis not set up yet; defaults degrade gracefully --
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- S3-compatible object storage (configured, unused until file features) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=

# --- AI sourcing assistant (buyer marketplace, optional) ----------------------
# Any OpenAI-compatible /chat/completions endpoint. When AI_API_KEY is empty
# the AI search fails gracefully (HTTP 503) and manual marketplace search keeps
# working. Server-side only — never expose this key to the browser.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Zero-cost option (OpenRouter free tier, needs a free API key):
#   AI_API_KEY=sk-or-...
#   AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   AI_BASE_URL=https://openrouter.ai/api/v1
# Deterministic offline provider (no key, no network) for local demos/tests:
#   AI_PROVIDER=mock

# --- Platform business parameters (docs/prd.md §15) ---------------------------
# Minimum order quantity (kg) and cooperative response window; env-configurable.
MIN_ORDER_QUANTITY_KG=1000
ORDER_RESPONSE_WINDOW_HOURS=24
