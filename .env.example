# =============================================================================
# GebeyaLink — environment template (placeholders only, no secrets)
# Copy relevant values into the app-level env file:
#   apps/web/.env          (Next.js + drizzle-kit — real values go here, never committed)
# =============================================================================

# --- Database (PostgreSQL on Supabase) ---------------------------------------
# Use the Session pooler URI from:
# Supabase Dashboard -> Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# --- Authentication (Better Auth) --------------------------------------------
# Generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=replace-with-generated-secret
BETTER_AUTH_URL=http://localhost:3000

# --- App URLs ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Base URL the Expo app uses to reach the API (your machine's LAN IP for devices)
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- Redis (cache) — local Redis not set up yet; defaults degrade gracefully --
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- S3-compatible object storage (configured, unused until file features) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=

# --- AI sourcing assistant (buyer marketplace, optional) ----------------------
# Providers: `openai` (any OpenAI-compatible /chat/completions endpoint),
# `gemini` (Google Generative Language API), or `mock` (deterministic, offline,
# no key — used by tests/e2e). When the key for the selected provider is empty,
# intent parsing fails gracefully (HTTP 503) and manual search keeps working.
# Recommendations never depend on a live model: eligibility, ranking and split
# sourcing are ordinary TypeScript, and the explanation degrades to a
# deterministic summary. Server-side only — never expose these keys.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Google Gemini (native REST — default provider). Free tier covers Flash /
# Flash-Lite models; quotas change over time and are never hardcoded here.
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Zero-cost OpenAI-compatible option (OpenRouter free tier, needs a free key):
#   AI_PROVIDER=openai
#   AI_API_KEY=sk-or-...
#   AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   AI_BASE_URL=https://openrouter.ai/api/v1
# Deterministic offline provider (no key, no network) for local demos/tests:
#   AI_PROVIDER=mock

# --- Geocoding (second third-party API, no key required) ----------------------
# Open-Meteo Geocoding powers the distance/proximity score component. No API
# key. NOTE: the free tier is licensed for non-commercial use (CC BY 4.0);
# production/commercial deployment needs a licence or self-hosting.
# Set GEOCODER_PROVIDER=off to disable (tests/e2e/offline) — proximity then
# scores as `unknown` and is never fabricated.
GEOCODER_PROVIDER=open-meteo
GEOCODER_BASE_URL=https://geocoding-api.open-meteo.com
GEOCODER_TIMEOUT_MS=8000
GEOCODER_MIN_INTERVAL_MS=1000

# --- Platform business parameters (docs/prd.md §15) ---------------------------
# Minimum order quantity (kg) and cooperative response window; env-configurable.
MIN_ORDER_QUANTITY_KG=1000
ORDER_RESPONSE_WINDOW_HOURS=24
